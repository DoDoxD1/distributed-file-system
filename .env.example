SUPABASE_DB_JDBC_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?user=postgres.exampleprojectref&password=replace-with-your-password
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
APP_HOSTNAME=localhost
JAVA_OPTS=-Xms512m -Xmx1024m
DISTRIBUTED_FS_STORAGE_HOST_PATH=C:/distributed-fs-data/chunks
DISTRIBUTED_FS_STORAGE_ROOT=/data/chunks
DISTRIBUTED_FS_ACCESS_TOKEN_TTL_SECONDS=900
DISTRIBUTED_FS_REFRESH_TOKEN_TTL_SECONDS=86400
DISTRIBUTED_FS_REFRESH_COOKIE_SECURE=true
DISTRIBUTED_FS_REFRESH_COOKIE_SAME_SITE=Strict
DFS_METADATA_DATASOURCE_URL=jdbc:postgresql://localhost:5432/distributedfs
DFS_METADATA_DATASOURCE_USERNAME=distributedfs
DFS_METADATA_DATASOURCE_PASSWORD=distributedfs
DFS_METADATA_DATASOURCE_MAX_POOL_SIZE=8
DFS_METADATA_DATASOURCE_CONNECTION_TIMEOUT_MS=30000

DISTRIBUTED_FS_STORAGE_BACKEND=oracle-object-storage
DISTRIBUTED_FS_ORACLE_OBJECT_STORAGE_NAMESPACE=
DISTRIBUTED_FS_ORACLE_OBJECT_STORAGE_BUCKET=
DISTRIBUTED_FS_ORACLE_OBJECT_STORAGE_CONFIG_FILE_PATH=

DISTRIBUTED_FS_BOOTSTRAP_ADMIN_EMAIL=
DISTRIBUTED_FS_BOOTSTRAP_ADMIN_PASSWORD=